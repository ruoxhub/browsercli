{
  "name": "browsercli",
  "type": "module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Standalone CLI client that talks to detached worker daemons over local socket sessions.",
  "bin": {
    "browsercli": "./build/bin/browsercli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json --noEmit false --outDir build && node --test build/tests/unit/**/*.test.js"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.4",
    "yargs": "^18.0.0",
    "zod": "^3.23.0",
    "debug": "^4.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/debug": "^4.1.0",
    "@types/yargs": "^17.0.0"
  }
}
