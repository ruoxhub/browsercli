{
  "name": "browsercli",
  "version": "2.0.3",
  "description": "JavaScript reverse engineering and debugging",
  "type": "module",
  "bin": {
    "js-reverse-worker": "./build/src/index.js"
  },
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', {recursive: true, force: true})\"",
    "bundle": "npm run clean && npm run build && rollup -c rollup.config.mjs",
    "build:dev": "swc src tests -d build --extensions .ts",
    "build": "npm run build:index && npm run build:compile && npm run web:build && npm run build:post",
    "typecheck": "tsc --noEmit",
    "format": "eslint --cache --fix src/ scripts/ || true; prettier --write --cache src/ scripts/",
    "check-format": "eslint --cache . && prettier --check --cache .;",
    "docs": "npm run build && npm run docs:generate && npm run format",
    "docs:generate": "node --experimental-strip-types scripts/generate-docs.ts",
    "debugger-lab": "node scripts/debugger-lab/server.mjs",
    "start": "npm run build && node build/src/index.js",
    "run": "node build/src/index.js",
    "start-debug": "DEBUG=mcp:* DEBUG_COLORS=false npm run build && node build/src/index.js",
    "test:node20": "node --require ./build/tests/setup.js --test-reporter spec --test-force-exit --test build/tests",
    "test": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test-reporter spec --test-force-exit --test \"build/tests/**/*.test.js\"",
    "test:unit": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/unit/**/*.test.js",
    "test:quick": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/unit/tools/**/*.test.js build/tests/unit/services/**/*.test.js build/tests/unit/utils/**/*.test.js",
    "test:property": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/property/**/*.test.js",
    "test:integration": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/integration/**/*.test.js",
    "test:vitest": "vitest run",
    "test:vitest:pure": "vitest run --project pure",
    "test:vitest:browser": "vitest run --project browser",
    "test:vitest:watch": "vitest watch",
    "test:perf": "RUN_PERF_TESTS=true npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/performance/**/*.test.js",
    "test:perf:baseline": "RUN_PERF_TESTS=true npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/performance/baseline.test.js",
    "coverage": "npm run coverage:core",
    "coverage:vitest": "vitest run --coverage",
    "coverage:core": "c8 --include=build/src/tools/dom/** --include=build/src/tools/hook/** --include=build/src/tools/stealth/** --include=build/src/services/AIService.js --include=build/src/services/LLMService.js --reporter=text --reporter=lcov node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/unit/**/*.test.js build/tests/property/**/*.test.js",
    "coverage:strict": "c8 --reporter=text --reporter=lcov node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test-force-exit --test build/tests/unit/**/*.test.js build/tests/property/**/*.test.js",
    "test:only": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test-reporter spec --test-force-exit --test --test-only \"build/tests/**/*.test.js\"",
    "test:only:no-build": "node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test-reporter spec --test-force-exit --test --test-only \"build/tests/**/*.test.js\"",
    "test:update-snapshots": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test-reporter spec --test-force-exit --test --test-update-snapshots \"build/tests/**/*.test.js\"",
    "prepare": "node --experimental-strip-types scripts/prepare.ts",
    "verify-server-json-version": "node --experimental-strip-types scripts/verify-server-json-version.ts",
    "case:jd:h5st:pure-node": "node scripts/cases/jd-h5st-pure-node.mjs",
    "cli:start": "browsercli start",
    "cli:worker:stop": "browsercli stop",
    "cli:worker:status": "browsercli status",
    "web:build": "tsc --noEmit -p src/web-ui/tsconfig.json && vite build --config vite.web-ui.config.ts",
    "web:dev": "vite --config vite.web-ui.config.ts",
    "web:typecheck": "tsc --noEmit -p src/web-ui/tsconfig.json",
    "build:index": "node --experimental-strip-types scripts/generate-tools-index.ts",
    "build:compile": "swc src tests -d build --extensions .ts --ignore \"src/web-ui/**\"",
    "build:post": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/post-build.ts",
    "verify-skills": "node --experimental-strip-types scripts/verify-skills-schema.ts",
    "test:worker": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/unit/worker/**/*.test.js",
    "test:registry": "npm run build && node --require ./build/tests/setup.js --no-warnings=ExperimentalWarning --test build/tests/unit/tools/ToolRegistry*.test.js"
  },
  "files": [
    "build/src",
    "build/web",
    "build/node_modules",
    "LICENSE",
    "!*.tsbuildinfo"
  ],
  "repository": "zhizhuodemao/js-reverse-mcp",
  "author": "zhizhuodemao",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zhizhuodemao/js-reverse-mcp/issues"
  },
  "homepage": "https://github.com/zhizhuodemao/js-reverse-mcp#readme",
  "mcpName": "io.github.zhizhuodemao/browsercli",
  "dependencies": {
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.5",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.29.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "axi-sdk-js": "^0.1.4",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "diff": "^8.0.4",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "javascript-obfuscator": "^5.4.1",
    "openai": "^4.73.0",
    "patchright": "^1.59.0",
    "sm-crypto": "^0.4.0",
    "terser": "^5.46.1",
    "wabt": "^1.0.39",
    "ws": "^8.20.0",
    "xbogus": "^1.0.2",
    "yargs": "18.0.0",
    "zod": "^3.25.76",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@swc/core-win32-x64-msvc": "^1.15.30",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/filesystem": "^0.0.36",
    "@types/node": "^24.3.3",
    "@types/sinon": "^21.0.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^4.1.6",
    "c8": "^10.1.3",
    "core-js": "3.47.0",
    "debug": "4.4.3",
    "eslint": "^9.35.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.5.3",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup": "4.53.3",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.6.0",
    "sinon": "^21.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.6",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "^1.15.33",
    "chrome-devtools-frontend": "^1.0.1608868",
    "cloakbrowser": "^0.3.28",
    "webcrack": "^2.16.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
